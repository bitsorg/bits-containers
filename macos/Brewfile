# macOS has no build container; the parallel to a bits-containers image is a
# Homebrew installation with this specific set of formulae. `brew bundle` against
# this file gives a Mac the same CONTENT guarantee the Linux images provide (see
# ../spec/CONTENT.md): the build tools, the -devel equivalents recipes take via
# prefer_system, and the compilers.
#
# Prerequisite NOT covered here: the Xcode Command Line Tools (`xcode-select
# --install`) — Apple clang + the macOS SDK. The clang compiler axis uses that
# (Apple clang versions do not map to LLVM majors; see clang-toolchain.sh).
#
# This list should be kept in sync with what the recipes actually request on
# macOS — regenerate the candidate set with:
#   scripts/extract-system-deps.py brew <path/to/*.bits ...>

# ── build tools (parallel to packages/build-tools.*.txt) ──────────────────────
brew "autoconf"
brew "automake"
brew "libtool"
brew "pkg-config"
brew "swig"
brew "bison"
brew "flex"
brew "gnu-tar"            # reproducible tarballs (GNU --sort/--mtime)
brew "gzip"
brew "make"
brew "m4"
brew "gettext"
brew "texinfo"
brew "modules"           # environment-modules (bits preload / module env)

# ── dev libraries (parallel to packages/dev-libs.*.txt) ───────────────────────
brew "openssl@3"
brew "xz"
brew "lz4"
brew "freetype"
brew "libpng"
brew "libxml2"
brew "readline"
brew "ncurses"
brew "krb5"
brew "ossp-uuid"

# ── compilers ─────────────────────────────────────────────────────────────────
brew "gcc"               # provides gfortran (no standalone gfortran formula)
brew "llvm"              # clang/clang++ for the clang axis (vs Apple clang)
